#!/usr/bin/env bash
# Run by Calamares inside the installed target, after unpackfs and before
# account creation. An error aborts installation, rather than leaving live login.
set -euo pipefail

test -f /usr/local/share/moenarch/pacman.conf
test -f /etc/sddm.conf.d/10-moenarch-live.conf
test -f /usr/share/applications/install-moenarch.desktop
id moenarch >/dev/null

# The live image has uid 1000; release it before Calamares creates the
# permanent user. Never enable live autologin for the installed system.
userdel -r moenarch
rm -f /etc/sddm.conf.d/10-moenarch-live.conf
rm -f /usr/share/applications/install-moenarch.desktop
rm -f /etc/polkit-1/rules.d/49-moenarch-installer.rules
rm -f /etc/systemd/system/getty@tty1.service
rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
rm -f /etc/systemd/system/multi-user.target.wants/moenarch-boot-marker.service

# The build-only repository must not leak into direct official Arch updates.
install -m0644 /usr/local/share/moenarch/pacman.conf /etc/pacman.conf
if grep -q '^\[moenarch-build\]' /etc/pacman.conf; then
  echo 'Build repository leaked into installed pacman.conf' >&2
  exit 1
fi

# Remove live-only installer package from the target without fetching a mirror.
pacman -Rdd --noconfirm moenarch-calamares
ln -sfn /usr/lib/systemd/system/sddm.service /etc/systemd/system/display-manager.service
ln -sfn /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target
systemctl enable NetworkManager.service
