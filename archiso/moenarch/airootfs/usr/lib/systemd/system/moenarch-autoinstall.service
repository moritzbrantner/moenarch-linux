[Unit]
Description=Run Moenarch automated installation acceptance harness
ConditionKernelCommandLine=moenarch.autoinstall=1
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/moenarch/autoinstall
TimeoutStartSec=15min
StandardOutput=journal+console
StandardError=journal+console
